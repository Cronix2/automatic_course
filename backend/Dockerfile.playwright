# Plan B: utiliser l'image officielle Playwright Python.
# Inclut déjà Python 3.11 + Chromium + toutes les libs système.
# Évite le problème de corruption de layer sur l'image python:3.11-slim.
FROM mcr.microsoft.com/playwright/python:v1.48.0-jammy AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DEBIAN_FRONTEND=noninteractive

# ffmpeg + audio + xvfb pour le mode headful du browser-login
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libsndfile1 \
    xvfb \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Chromium est déjà installé dans l'image de base, pas besoin de playwright install.

COPY app ./app

RUN mkdir -p /app/data /app/models/piper

EXPOSE 8001

CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8001", "--proxy-headers"]
