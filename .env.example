# =============================================================================
# Automatic Course - Example environment file
# Copy this file to `.env` at the project root and fill in real values.
# NEVER commit `.env` to git. NEVER hardcode secrets in source code.
# =============================================================================

# ---- Core ------------------------------------------------------------------
# Bind addresses / ports
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001
FRONTEND_PORT=5173
PUBLIC_BASE_URL=http://localhost:8001

# Environment: development | production
APP_ENV=development

# ---- Security --------------------------------------------------------------
# 32-byte base64-encoded master key used to encrypt secrets at rest (AES-GCM).
# Generate with: python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
APP_MASTER_KEY=

# Random session secret (used to sign session cookies). Generate with:
# python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# CORS allowed origins (comma separated)
CORS_ORIGINS=http://localhost:5173

# ---- Database --------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# ---- OAuth (GitHub) --------------------------------------------------------
# Create an OAuth app at https://github.com/settings/developers
# Callback URL must be: ${PUBLIC_BASE_URL}/api/oauth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ---- Local AI/ML models ----------------------------------------------------
# STT (faster-whisper)
WHISPER_MODEL=base            # tiny | base | small | medium | large-v3
WHISPER_DEVICE=auto           # auto | cpu | cuda
WHISPER_COMPUTE_TYPE=auto     # auto | int8 | int8_float16 | float16 | float32

# TTS (Piper)
PIPER_VOICE=fr_FR-siwis-medium
PIPER_MODELS_DIR=./models/piper

# ---- TryHackMe -------------------------------------------------------------
# Credentials are NEVER stored in env; they are entered in the Settings UI
# and stored AES-GCM encrypted in the local DB.
THM_BASE_URL=https://tryhackme.com

# Debug: open the Playwright browser visibly + slow down actions so you can
# follow the login flow. Only useful when running the backend on a machine
# with a display (i.e. NOT inside the headless Docker container).
# Run `cd backend && uvicorn app.main:app --reload` after setting these.
THM_HEADFUL=0
THM_SLOW_MO_MS=0
THM_DEBUG_DIR=./data/thm-debug

# ---- Misc ------------------------------------------------------------------
LOG_LEVEL=INFO
